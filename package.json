{
  "name": "narrator-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node scripts/dev.mjs --production",
    "test": "node --test frontend/tests/*.test.mjs",
    "format": "prettier --write frontend/src frontend/tests frontend/vite.config.js frontend/index.html scripts package.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^7.2.2"
  }
}
